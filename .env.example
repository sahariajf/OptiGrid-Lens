# ---------------------------------------------------------------------------
# GridWise - environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Required. Anthropic API key used for operator-note interpretation.
ANTHROPIC_API_KEY=

# Optional. Model used to interpret operator_notes. Default: claude-opus-5
GRIDWISE_MODEL=claude-opus-5

# Optional. Hard timeout (ms) for the interpretation call before the service
# falls back to a controlled degraded path. Default: 12000
GRIDWISE_LLM_TIMEOUT_MS=12000

# Optional. Port the server binds to. Default: 3000
PORT=3000
