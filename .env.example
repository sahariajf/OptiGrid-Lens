# ---------------------------------------------------------------------------
# GridWise - environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Which model interprets operator_notes: "openai" or "gemini".
# This is the only line you change to switch providers.
LLM_PROVIDER=openai

# Optional. Overrides the provider's default model id.
# Defaults: openai -> gpt-5.4-mini, gemini -> gemini-3.8-flash
# Run: npm run models   to list what your account actually exposes.
LLM_MODEL=

# TOTAL budget (ms) for interpretation, shared across the primary provider AND
# any fallback attempt - not a per-provider timeout. A single attempt is capped
# at 8s so a hung primary always leaves the fallback something to work with.
# Keeps a full failover chain inside the 5-15s latency band, well clear of the
# harness's 30s threshold where slow becomes failed.
LLM_TIMEOUT_MS=12000

# OpenAI reasoning effort: none | minimal | low | medium | high. Default: low.
# Measured on the public pack: low scores 100% interpretation at ~2.9s mean;
# minimal collapses to 22% and is no faster. Do not lower this without
# re-running: npm run eval

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Required when LLM_PROVIDER=gemini. An AI Studio key, starts with "AIza".
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Port the server binds to. Default: 3000
PORT=3000
