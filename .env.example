# ---------------------------------------------------------------------------
# GridWise - environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Which model interprets operator_notes: "openai" or "gemini".
# This is the only line you change to switch providers.
LLM_PROVIDER=openai

# Optional. Overrides the provider's default model id.
# Defaults: openai -> gpt-5, gemini -> gemini-3-pro
LLM_MODEL=

# Hard timeout (ms) for the interpretation call before the service falls back
# to a controlled degraded path. Kept well under the harness's 30s limit.
LLM_TIMEOUT_MS=12000

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Optional. Port the server binds to. Default: 3000
PORT=3000
